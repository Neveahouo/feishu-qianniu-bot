# ============================================
# 飞书自建应用凭据
# 在 https://open.feishu.cn 开发者后台 -> 凭证与基础信息 中获取
# ============================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# ============================================
# 千牛 / 淘宝卖家后台登录凭据
# 仅在自动填充表单时使用；淘宝通常会要求扫码登录
# ============================================
QIANNIU_USERNAME=
QIANNIU_PASSWORD=

# ============================================
# 业务参数（可选，留空使用默认值）
# ============================================
# 恢复限购时的默认份数
DEFAULT_LIMIT=20

# 浏览器是否显示界面：true=有头（推荐，便于扫码登录）
HEADLESS=false

# 操作超时（毫秒）
OP_TIMEOUT=30000
